# Docker Hub images consumed by docker compose
BACKEND_IMAGE=shlol762/questiondb-backend:latest
FRONTEND_IMAGE=shlol762/questiondb-frontend:latest

# Database container credentials
POSTGRES_DB=questionbank
POSTGRES_USER=questionbank
POSTGRES_PASSWORD=replace_me_with_strong_password

# Backend auth/config
SECRET_KEY=replace_me_with_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=false
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_RELOAD=false

# Frontend published port on host
FRONTEND_PORT=80
