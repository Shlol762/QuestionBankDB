# Database container credentials
POSTGRES_DB=questionbank
POSTGRES_USER=questionbank
POSTGRES_PASSWORD=replace_me_with_strong_password

# Backend runtime connection string (must use the postgres service name)
POSTGRES_URL=postgresql+asyncpg://questionbank:replace_me_with_strong_password@postgres:5432/questionbank

# Backend auth/config
SECRET_KEY=replace_me_with_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FORCE_HTTPS=true
TRUST_PROXY_HEADERS=true
CORS_ALLOW_ORIGINS=https://your-frontend-domain.example

# Frontend published port on host
FRONTEND_PORT=80
