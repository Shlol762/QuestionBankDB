# ==============================================================================
# Question Bank Platform - Unified Environment Configuration
# Copy this file to '.env' in the root directory.
# This single file is used for both local development and Docker Compose setups.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE SETTINGS
# ------------------------------------------------------------------------------
# Credentials used to bootstrap the Database container (Docker Compose) and connect
# to PostgreSQL (both in local dev and Docker compose).
POSTGRES_DB=questionbank
POSTGRES_USER=questionbank
POSTGRES_PASSWORD=replace_me_with_strong_password

# Database host location and port details:
# Set to 'localhost' for local developer machines, 'postgres' for Docker Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secure random string for JWT token signatures.
SECRET_KEY=REPLACE_WITH_A_SECURE_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 3. NETWORK & WEB CONFIGURATION
# ------------------------------------------------------------------------------
# CORS: Comma-separated allowed origins (frontend server addresses).
# Include http://localhost:5173 for local frontend dev server, and http://localhost for Docker Compose.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

FORCE_HTTPS=false
TRUST_PROXY_HEADERS=false

# ------------------------------------------------------------------------------
# 4. DOCKER ORCHESTRATION & CONTAINER CONFIG (Only used by docker-compose)
# ------------------------------------------------------------------------------
# Image tags to pull or build
BACKEND_IMAGE=shlok762d/questiondb-backend:latest
FRONTEND_IMAGE=shlok762d/questiondb-frontend:latest

# Ports exposed on host machine
FRONTEND_PORT=80
BACKEND_PORT=8000

# Backend runtime parameters inside the container
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_RELOAD=false
